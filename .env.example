# ================= 运行模式 =================
# demo: 离线模拟数据（无需任何外部依赖，开箱即用）
# live: 真实链上数据（需可访问 GeckoTerminal / RugCheck 公共接口 + Solana RPC）
MODE=demo

# Solana RPC 地址（仅 live 模式使用；扫链需支持 WebSocket，建议 Helius/QuickNode）
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ================= 链上扫链发现（live） =================
# true：订阅 Pump + Raydium program logs 发现新币；false：回退 Gecko new_pools 轮询
CHAIN_SCAN_ENABLED=true
# 启用的程序族：pump,raydium（逗号分隔）；也可写 all
CHAIN_SCAN_PROGRAMS=pump,raydium
# 日志订阅 commitment：processed（更快发现）| confirmed | finalized
# 注意：拉交易始终用 confirmed+（RPC 限制），此项只影响 onLogs
CHAIN_SCAN_COMMITMENT=processed
# 并行解析交易数（1-8；公共 mainnet-beta 建议 1，付费 RPC 可 3-4）
CHAIN_SCAN_PARSE_CONCURRENCY=1
# true：Pump 新币走 PumpPortal 免费 WS（推荐，躲开公共 RPC 429）；链上只订 Raydium
# 同时订阅 subscribeMigration（Pump 毕业外盘）
PUMPPORTAL_ENABLED=true
# true：链上扫链开启时并行 Gecko new_pools，补非 Pump 毕业的外盘新 pair
GECKO_DISCOVERY_ENABLED=true

# ================= 双进程端口 =================
# Bot API（/api/state · /api/events），Next.js 通过 rewrite 代理到此端口
BOT_API_PORT=3940
# Next.js 看板端口
WEB_PORT=3939

# ================= 六模块筛选阈值 =================
# 流动性低于该值（美元）→ 直接排除
MIN_LIQUIDITY_USD=50000
# 是否要求 LP 已锁定/已燃烧（true = 未锁不碰）
REQUIRE_LP_LOCKED=true
# 项目方持仓超过该百分比 → 直接跳过
MAX_DEV_HOLDING_PCT=7
# 前 10 大持仓合计上限（%）
MAX_TOP10_HOLDING_PCT=35
# 持仓超过该占比即视为鲸鱼（%）
WHALE_HOLDING_PCT=5
# 最低持有人数（低于则观察）
MIN_HOLDERS=100
# 池子最小年龄（毫秒，太新观望）/ 最大年龄（太老不追）
MIN_POOL_AGE_MS=60000
MAX_POOL_AGE_MS=86400000

# ================= 交易 / 风控（纸面） =================
POSITION_SIZE_USD=100
# 触发「让利润奔跑」的涨幅（%），超过后转移动止损
MOON_ACTIVATE_PCT=30
STOP_LOSS_PCT=10
TRAILING_STOP_PCT=20
MAX_CONCURRENT_POSITIONS=5
SLIPPAGE_PCT=2

# ================= 模拟 / 运行参数 =================
SIM_SEED=20241013
SIM_INITIAL_TOKENS=12
SIM_TOKEN_INTERVAL_MS=6000
MONITOR_MS=4000
# demo 模式且未启 API 时的运行时长（毫秒），到时自动停止并输出报告
RUN_DURATION_MS=60000
