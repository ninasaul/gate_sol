{
  "name": "gatesol",
  "version": "0.1.0",
  "description": "GateSol — Solana meme filter gates + paper trading",
  "type": "module",
  "scripts": {
    "bot": "tsx src/index.ts --api",
    "bot:demo": "tsx src/index.ts --demo --api",
    "bot:live": "tsx src/index.ts --live --api",
    "demo": "tsx src/index.ts --demo",
    "live": "tsx src/index.ts --live",
    "web": "next dev -p ${WEB_PORT:-3939}",
    "dev": "concurrently -k -n bot,web -c cyan,magenta \"tsx src/index.ts --demo --api\" \"next dev -p ${WEB_PORT:-3939}\"",
    "dev:live": "concurrently -k -n bot,web -c cyan,magenta \"tsx src/index.ts --live --api\" \"next dev -p ${WEB_PORT:-3939}\"",
    "build": "tsc -p tsconfig.bot.json && next build",
    "build:bot": "tsc -p tsconfig.bot.json",
    "build:web": "next build",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src app components lib messages tests --max-warnings 0",
    "typecheck": "tsc -p tsconfig.bot.json --noEmit && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.8",
    "concurrently": "^10.0.6",
    "dotenv": "^16.4.5",
    "lightweight-charts": "^5.2.1",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
